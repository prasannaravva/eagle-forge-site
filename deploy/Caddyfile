# Caddy serves the built site and gets and renews the HTTPS certificate on its own.
# DOMAIN comes from the environment (docker-compose.yml); "localhost" for a local test.

{$DOMAIN:localhost} {
	root * /srv
	encode zstd gzip

	# Hashed build files never change: cache them for a year. Everything else revalidates.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# One-page site: unknown paths fall back to the page itself.
	try_files {path} /index.html
	file_server
}

# www.eaglenexa.ai sends visitors to eaglenexa.ai.
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}
